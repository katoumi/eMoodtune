<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mixCardRoot"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_player_mini_card_figma"
    android:orientation="vertical"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvMixMood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HAPPY"
        android:textColor="#FFD54F"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMixLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Mood Mix"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMixStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="12 songs"
        android:textColor="#8D84A8"
        android:textSize="10sp" />

</LinearLayout>
